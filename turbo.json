{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "env": ["DATABASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
