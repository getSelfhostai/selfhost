# Caddy in front of selfhost (compose.tls.yml): HTTPS for SELFHOST_DOMAIN with a certificate it
# gets and renews by itself, on ports 80 and 443. The selfhost API and the collector stay inside
# Docker; this is the only way in.
#
#   /v1/*    the selfhost API, behind its bearer tokens (CLIs, hooks, the GitHub webhook)
#   /otlp/*  agents' OpenTelemetry over HTTP, behind the agent token checked by the collector
#   /llm/*   the AI gateway's model routes, behind its virtual keys (compose.gateway.yml)
#   the rest the web console, which the selfhost server serves: each person signs in with their
#            own token, or with GitHub or Google when compose.signin.yml is in use

# Without compose.signin.yml the console asks each person for their token (a person token from
# selfhost team join, or the admin token). Its pages hold no data; everything it shows comes
# from /v1 with that token.
(console-token) {
	handle {
		reverse_proxy selfhost:4400
	}
}

# With compose.signin.yml: oauth2-proxy checks the sign-in cookie on each request and sends
# people without one to GitHub or Google first.
(console-signin) {
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			@signed_out status 401
			handle_response @signed_out {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		reverse_proxy selfhost:4400
	}
}

# Bearer tokens only.
(api-token) {
	request_header -X-Selfhost-Email
}

# With compose.signin.yml, a signed-in browser's own reads of /v1 (GET, no bearer token, the
# sign-in cookie) also say who signed in: oauth2-proxy answers with the email, and the secret
# tells the server the email came from here. The server reads, never writes, as that person.
(api-signin) {
	@browser {
		method GET HEAD
		not header Authorization *
		header Cookie *_oauth2_proxy*
	}
	forward_auth @browser oauth2-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-Email>X-Selfhost-Email
	}
	request_header @browser X-Selfhost-Proxy-Secret {$SELFHOST_SIGNIN_PROXY_SECRET}
}

# Without compose.gateway.yml there is no gateway: /llm/ falls through to the console's 404.
(gateway-off) {
}

# With compose.gateway.yml: agents' model traffic to Bifrost, which refuses any request without
# a virtual key it knows. Only its model routes and /health are served; its management API and
# web UI stay inside Docker.
(gateway-on) {
	handle_path /llm/* {
		@model path /anthropic/* /openai/* /v1/* /health
		handle @model {
			reverse_proxy bifrost:8080
		}
		handle {
			respond 404
		}
	}
}

{$SELFHOST_DOMAIN} {
	encode zstd gzip

	# Only this file sets these, after sign-in; whatever a client sends is dropped first.
	request_header -X-Selfhost-Email
	request_header -X-Selfhost-Proxy-Secret

	handle /v1/* {
		import api-{$SELFHOST_CONSOLE_ACCESS:token}
		reverse_proxy selfhost:4400
	}

	handle_path /otlp/* {
		reverse_proxy otel-collector:4318
	}

	import gateway-{$SELFHOST_GATEWAY:off}

	import console-{$SELFHOST_CONSOLE_ACCESS:token}
}
