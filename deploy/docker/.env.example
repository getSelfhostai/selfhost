# selfhost Docker Compose settings. Copy to .env next to compose.yml and fill in the blanks.
# Never commit .env. Generate each secret with: openssl rand -hex 32

# --- Required ---------------------------------------------------------------

# Release to run. To upgrade, change this and run:
#   docker compose pull && docker compose up -d
SELFHOST_VERSION=0.1.0

# Postgres password. Keep it URL safe (hex is), it is part of DATABASE_URL.
POSTGRES_PASSWORD=

# Bearer token for the selfhost API (http://<server>:4400). Admin access: keep it on the server
# and on the laptop of whoever runs the team (selfhost up saves it in ~/.selfhost/config.json,
# mode 0600), never on the laptops agents run on.
SELFHOST_TOKEN=

# Bearer token agents send to the collector (OTLP on 4317 and 4318). It can only write telemetry.
SELFHOST_OTLP_TOKEN=

# --- Optional (defaults shown) ----------------------------------------------

# Image to pull or tag a local build as.
# SELFHOST_IMAGE=ghcr.io/getselfhostai/selfhost

# Database name and user, created on the first start of an empty volume.
# POSTGRES_DB=selfhost
# POSTGRES_USER=selfhost

# Address and port the API is published on. Use 127.0.0.1 behind a reverse proxy.
# SELFHOST_BIND=0.0.0.0
# SELFHOST_PORT=4400

# On start and then once a day the server deletes events older than their retention: 90 days,
# or ledger.retention_days in a team's selfhost.toml. off keeps every event.
# SELFHOST_RETENTION_SWEEP=daily

# GitHub App for labels, the selfhost/review check and review requests on agent pull requests
# (see apps/server/README.md#github-app). POST /v1/github/webhooks answers 404 until the first
# three are set. The private key goes on one line, in double quotes, with \n for each line break.
# SELFHOST_GITHUB_APP_ID=
# SELFHOST_GITHUB_PRIVATE_KEY=
# SELFHOST_GITHUB_WEBHOOK_SECRET=
# Team whose stored selfhost.toml sets [review] github_logins and github_team.
# SELFHOST_GITHUB_TEAM=

# Address and ports the collector's OTLP receivers are published on.
# OTLP_BIND=0.0.0.0
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# URL people reach the server at, used in links the server writes (brief traces).
# SELFHOST_PUBLIC_URL=

# --- HTTPS, sign-in and backups (selfhost up and install.sh) --------------------

# Extra compose files: compose.tls.yml puts Caddy with HTTPS in front, and compose.signin.yml
# adds GitHub or Google sign-in for the console. With them, set SELFHOST_BIND and OTLP_BIND to
# 127.0.0.1 so only ports 80 and 443 face the internet.
# COMPOSE_FILE=compose.yml:compose.tls.yml:compose.signin.yml

# Hostname Caddy serves over HTTPS. Its DNS must point at this server.
# SELFHOST_DOMAIN=selfhost.example.com

# Console sign-in: github or google, the OAuth app's client id and secret, a 32 character cookie
# secret (openssl rand -hex 16), and who may sign in: email domains (comma separated), the
# emails listed in signin-emails.txt, and for GitHub one organization.
# SELFHOST_SIGNIN_PROVIDER=github
# SELFHOST_SIGNIN_CLIENT_ID=
# SELFHOST_SIGNIN_CLIENT_SECRET=
# SELFHOST_SIGNIN_COOKIE_SECRET=
# SELFHOST_SIGNIN_EMAIL_DOMAINS=example.com
# SELFHOST_SIGNIN_GITHUB_ORG=

# Daily backup that install.sh schedules: time of day in UTC, and days of backups to keep.
# SELFHOST_BACKUP_TIME=03:00
# SELFHOST_BACKUP_KEEP_DAYS=14
