# selfhost Docker Compose settings. Copy to .env next to compose.yml and fill in the blanks.
# Never commit .env. Generate each secret with: openssl rand -hex 32

# --- Required ---------------------------------------------------------------

# Release to run. To upgrade or roll back, run ./upgrade.sh <version>, which sets it here.
SELFHOST_VERSION=0.1.0

# Postgres password. Keep it URL safe (hex is), it is part of DATABASE_URL.
POSTGRES_PASSWORD=

# Bearer token for the selfhost API (http://<server>:4400). Admin access: keep it on the server
# and on the laptop of whoever runs the team (selfhost up saves it in ~/.selfhost/config.json,
# mode 0600), never on the laptops agents run on.
SELFHOST_TOKEN=

# Bearer token agents send to the collector (OTLP on 4317 and 4318). It can only write telemetry.
SELFHOST_OTLP_TOKEN=

# --- Optional (defaults shown) ----------------------------------------------

# Image to pull or tag a local build as.
# SELFHOST_IMAGE=ghcr.io/getselfhostai/selfhost

# Database name and user, created on the first start of an empty volume.
# POSTGRES_DB=selfhost
# POSTGRES_USER=selfhost

# Address and port the API is published on. 127.0.0.1 by default: this server only, as behind
# compose.tls.yml. 0.0.0.0 publishes plain HTTP to every network, for a private network only.
# SELFHOST_BIND=127.0.0.1
# SELFHOST_PORT=4400

# On start and then once a day the server deletes events older than their retention: 90 days,
# or ledger.retention_days in a team's selfhost.toml. off keeps every event.
# SELFHOST_RETENTION_SWEEP=daily

# GitHub App for labels, the selfhost/review check and review requests on agent pull requests
# (see apps/server/README.md#github-app). POST /v1/github/webhooks answers 404 until the first
# three are set. The private key goes on one line, in double quotes, with \n for each line break.
# SELFHOST_GITHUB_APP_ID=
# SELFHOST_GITHUB_PRIVATE_KEY=
# SELFHOST_GITHUB_WEBHOOK_SECRET=
# Team whose stored selfhost.toml sets [review] github_logins and github_team.
# SELFHOST_GITHUB_TEAM=
# Proof receipts from CI (POST /v1/receipts) come with the job's GitHub Actions OIDC token. On
# GitHub Enterprise Server, its issuer: https://<host>/_services/token.
# SELFHOST_GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Address and ports the collector's OTLP receivers are published on. 127.0.0.1 by default.
# OTLP_BIND=127.0.0.1
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# URL people reach the server at, used in links the server writes (brief traces, receipts) and
# as the audience of the CI tokens proof receipts are posted with.
# SELFHOST_PUBLIC_URL=

# --- Background runs ------------------------------------------------------------

# Background runs need a runtime: the key of the team's runtime account, and for the team's own
# OpenSandbox server or Coder its url. A team's stored policy picks the runtime, but never its
# url or key variable: those come from here, or from the server's own selfhost.toml. To use one,
# put it in ./config (mounted read-only at /config) and point SELFHOST_CONFIG at it. The image
# already includes each runtime's SDK. See README.md#background-runs.
# SELFHOST_CONFIG=/config/selfhost.toml
# SELFHOST_RUNTIME_OPENSANDBOX_URL=http://opensandbox:8090
# OPEN_SANDBOX_API_KEY=
# SELFHOST_RUNTIME_CODER_URL=https://coder.example.com
# CODER_SESSION_TOKEN=
# E2B_API_KEY=
# DAYTONA_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- HTTPS, sign-in and backups (selfhost up and install.sh) --------------------

# Extra compose files: compose.tls.yml puts Caddy with HTTPS in front, compose.signin.yml
# adds GitHub or Google sign-in for the console, compose.gateway.yml the AI gateway and
# compose.notify.yml notifications. Keep SELFHOST_BIND and OTLP_BIND at 127.0.0.1 with
# them, so only ports 80 and 443 face the internet.
# COMPOSE_FILE=compose.yml:compose.tls.yml:compose.signin.yml

# Hostname Caddy serves over HTTPS. Its DNS must point at this server.
# SELFHOST_DOMAIN=selfhost.example.com

# Console sign-in: github or google, the OAuth app's client id and secret, a 32 character cookie
# secret (openssl rand -hex 16), and who may sign in: email domains (comma separated), the
# emails listed in signin-emails.txt, and for GitHub one organization.
# SELFHOST_SIGNIN_PROVIDER=github
# SELFHOST_SIGNIN_CLIENT_ID=
# SELFHOST_SIGNIN_CLIENT_SECRET=
# SELFHOST_SIGNIN_COOKIE_SECRET=
# SELFHOST_SIGNIN_EMAIL_DOMAINS=example.com
# SELFHOST_SIGNIN_GITHUB_ORG=

# Shared by Caddy and the server with compose.signin.yml, so the server believes the signed-in
# email only when Caddy sends it. install.sh generates it when empty.
SELFHOST_SIGNIN_PROXY_SECRET=
# The org console sign-in is for, when an email is in teams of several orgs (person ids are
# unique within an org only). Unset: the org the email joined first.
# SELFHOST_SIGNIN_ORG=

# --- Notifications (compose.notify.yml) ----------------------------------------

# Add compose.notify.yml to COMPOSE_FILE to run Apprise next to the server: alerts and digests
# then reach each person's phone, chat or inbox (selfhost notify add <apprise-url>). Or point
# the server at an Apprise API server the team already runs instead:
# SELFHOST_APPRISE_URL=http://apprise.internal:8000

# --- AI gateway (compose.gateway.yml, selfhost up --gateway) -------------------

# Add compose.gateway.yml to COMPOSE_FILE (after compose.tls.yml) to run Bifrost next to the
# server. Agents reach it at https://<SELFHOST_DOMAIN>/llm/ with a virtual key selfhost issues.

# Bifrost's admin password, which the selfhost server writes keys and budgets with, and the key
# that encrypts what Bifrost stores. install.sh generates both when empty; never change the
# encryption key once Bifrost has started with it.
SELFHOST_GATEWAY_ADMIN_KEY=
SELFHOST_GATEWAY_ENCRYPTION_KEY=

# Provider keys, which only the gateway container sees. install.sh lists a provider in
# bifrost.json only when its keys are set; run it again after adding one. Regions are pinned
# here. VERTEX_CREDENTIALS is the service account JSON on one line.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FIREWORKS_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_API_KEY=
# AZURE_ENDPOINT=https://<resource>.openai.azure.com
# VERTEX_PROJECT_ID=
# VERTEX_REGION=us-central1
# VERTEX_CREDENTIALS=

# A LiteLLM proxy the team already runs, instead of the bundled Bifrost: leave
# compose.gateway.yml out, set these, and put LiteLLM's master key in SELFHOST_GATEWAY_ADMIN_KEY.
# The public URL is where agents reach it, when that is not the URL the server uses.
# SELFHOST_GATEWAY_TOOL=litellm
# SELFHOST_GATEWAY_URL=http://litellm.internal:4000
# SELFHOST_GATEWAY_PUBLIC_URL=https://litellm.example.com

# Address and port Bifrost's own web UI is published on, for an SSH tunnel. Keep it on 127.0.0.1.
# GATEWAY_BIND=127.0.0.1
# GATEWAY_PORT=8080

# Daily backup that install.sh schedules: time of day in UTC, and days of backups to keep.
# SELFHOST_BACKUP_TIME=03:00
# SELFHOST_BACKUP_KEEP_DAYS=14
