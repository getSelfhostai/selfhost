# selfhost Docker Compose settings. Copy to .env next to compose.yml and fill in the blanks.
# Never commit .env. Generate each secret with: openssl rand -hex 32

# --- Required ---------------------------------------------------------------

# Release to run. To upgrade, change this and run:
#   docker compose pull && docker compose up -d
SELFHOST_VERSION=0.1.0

# Postgres password. Keep it URL safe (hex is), it is part of DATABASE_URL.
POSTGRES_PASSWORD=

# Bearer token for the selfhost API (http://<server>:4400). Admin access: keep it off laptops.
SELFHOST_TOKEN=

# Bearer token agents send to the collector (OTLP on 4317 and 4318). It can only write telemetry.
SELFHOST_OTLP_TOKEN=

# --- Optional (defaults shown) ----------------------------------------------

# Image to pull or tag a local build as.
# SELFHOST_IMAGE=ghcr.io/getselfhostai/selfhost

# Database name and user, created on the first start of an empty volume.
# POSTGRES_DB=selfhost
# POSTGRES_USER=selfhost

# Address and port the API is published on. Use 127.0.0.1 behind a reverse proxy.
# SELFHOST_BIND=0.0.0.0
# SELFHOST_PORT=4400

# Address and ports the collector's OTLP receivers are published on.
# OTLP_BIND=0.0.0.0
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
