{
  "name": "selfhost",
  "version": "0.1.0",
  "private": true,
  "description": "The open backend for your coding agent fleet: one ledger, one review list, one team config across every coding agent.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "build:cli": "pnpm --filter @selfhost/cli build:cli",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "release:version": "node scripts/release/version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
