        "status": "modified",
        "additions": 5,
        "deletions": 1,
        "patch": "@@ -18,5 +18,9 @@ export async function findKey(token: string) {\n   const key = await db.apiKeys.findByHash(hash(token));\n   if (!key) return undefined;\n-  return key;\n+  return {\n+    ...key,\n+    // The plan tier sets the default limit.\n+    rateLimit: key.rateLimit ?? DEFAULT_RATE_LIMIT,\n+  };\n }\n "
      },
      {
        "path": "src/middleware/rate-limit.ts",
        "status": "added",
        "additions": 12,
        "deletions": 0,
        "patch": "@@ -0,0 +1,12 @@\n+import { Redis } from \"ioredis\";\n+import { findKey } from \"../auth/keys.js\";\n+\n+const redis = new Redis(process.env.REDIS_URL);\n+\n+export async function rateLimit(token: string): Promise<boolean> {\n+  const key = await findKey(token);\n+  if (!key) return false;\n+  const used = await redis.incr(`limit:${key.id}`);\n+  if (used === 1) await redis.expire(`limit:${key.id}`, 60);\n+  return used <= key.rateLimit;\n+}"
      },
