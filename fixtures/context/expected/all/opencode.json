{
  "mcp": {
    "docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@acme/docs-mcp"
      ],
      "environment": {
        "DOCS_TOKEN": "{env:DOCS_TOKEN}",
        "DOCS_REGION": "eu"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  }
}
