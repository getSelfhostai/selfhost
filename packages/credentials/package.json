{
  "name": "@selfhost/credentials",
  "version": "0.0.0",
  "private": true,
  "description": "Short-lived, least-privilege credentials and one egress policy per run: a GitHub App token for the run's one repository, a per-run AI gateway key, secrets read from env, Vault or Infisical, all translated into each runtime's and each local sandbox's own controls, revoked at run end and masked in the ledger.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@selfhost/gateway": "workspace:*",
    "@selfhost/github": "workspace:*",
    "@selfhost/ledger": "workspace:*",
    "@selfhost/policy": "workspace:*",
    "@selfhost/runtime": "workspace:*",
    "@selfhost/schema": "workspace:*"
  },
  "devDependencies": {
    "@octokit/rest": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
