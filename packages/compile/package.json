{
  "name": "@selfhost/compile",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles selfhost.toml into each coding agent's native controls, with the coverage of every rule per agent.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ruler": "./src/ruler.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ruler": {
        "types": "./dist/ruler.d.ts",
        "import": "./dist/ruler.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/ruler.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@intellectronica/ruler": "catalog:",
    "@selfhost/agents": "workspace:*",
    "@selfhost/policy": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "picomatch": "catalog:",
    "regjsparser": "catalog:",
    "smol-toml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
