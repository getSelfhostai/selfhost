{
  "name": "@selfhost/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Configures the AI gateway (Bifrost, or LiteLLM a team already runs) from the team policy: virtual keys per person, team and run with budgets and fallbacks, and its request logs read into the ledger.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@selfhost/ledger": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "@selfhost/spend": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
