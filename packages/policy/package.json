{
  "name": "@selfhost/policy",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluates the rules in selfhost.toml against tool calls and records what they would have blocked in the ledger.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@selfhost/ledger": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@selfhost/importers": "workspace:*",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
