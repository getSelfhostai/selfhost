{
  "name": "@selfhost/notify",
  "version": "0.0.0",
  "private": true,
  "description": "Phone, chat and email notifications through Apprise: instant pushes for agents that wait, budget alerts, and each person's digest, with every send recorded and no secrets in a message.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@selfhost/gateway": "workspace:*",
    "@selfhost/ledger": "workspace:*",
    "@selfhost/review": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "@selfhost/spend": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
