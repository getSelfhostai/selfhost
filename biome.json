{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!docs/build-plan",
      "!fixtures",
      "!packages/schema/json",
      "!packages/schema/compat",
      "!packages/schema/mcp-tools.json",
      "!packages/schema/event-versions.json",
      "!docs/compatibility",
      "!deploy/src/stack.generated.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!ee/**", "!apps/cli/src/ee.ts", "!apps/server/src/ee.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@selfhost/ee-*", "**/ee/**"],
                    "message": "Code outside ee/ is Apache-2.0 and must not import the commercial ee/ packages. The CLI and the server load them only through apps/cli/src/ee.ts and apps/server/src/ee.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
