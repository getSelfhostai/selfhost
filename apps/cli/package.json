{
  "name": "@selfhost/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The selfhost command line.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "selfhost": "./dist/main.js"
  },
  "files": [
    "dist/*.js",
    "AGENTS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "build:cli": "tsx scripts/build-binaries.ts",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@selfhost/agents": "workspace:*",
    "@selfhost/attribution": "workspace:*",
    "@selfhost/brief": "workspace:*",
    "@selfhost/compile": "workspace:*",
    "@selfhost/ee-risk": "workspace:*",
    "@selfhost/importers": "workspace:*",
    "@selfhost/ledger": "workspace:*",
    "@selfhost/policy": "workspace:*",
    "@selfhost/pr": "workspace:*",
    "@selfhost/review": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "@selfhost/spend": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@selfhost/server": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
