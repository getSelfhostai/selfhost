{
  "name": "@selfhost/server",
  "version": "0.0.0",
  "private": true,
  "description": "selfhost HTTP API server.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@selfhost/attribution": "workspace:*",
    "@selfhost/ee-risk": "workspace:*",
    "@selfhost/github": "workspace:*",
    "@selfhost/ledger": "workspace:*",
    "@selfhost/policy": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "hono": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@octokit/webhooks": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
