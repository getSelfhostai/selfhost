{
  "name": "@selfhost/server",
  "version": "0.0.0",
  "private": true,
  "description": "selfhost HTTP API server.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./local": "./src/local.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@selfhost/attribution": "workspace:*",
    "@selfhost/background": "workspace:*",
    "@selfhost/brief": "workspace:*",
    "@selfhost/compile": "workspace:*",
    "@selfhost/context": "workspace:*",
    "@selfhost/credentials": "workspace:*",
    "@selfhost/ee-receipt": "workspace:*",
    "@selfhost/ee-risk": "workspace:*",
    "@selfhost/gateway": "workspace:*",
    "@selfhost/github": "workspace:*",
    "@selfhost/integrations": "workspace:*",
    "@selfhost/ledger": "workspace:*",
    "@selfhost/mcp": "workspace:*",
    "@selfhost/notify": "workspace:*",
    "@selfhost/policy": "workspace:*",
    "@selfhost/pr": "workspace:*",
    "@selfhost/provenance": "workspace:*",
    "@selfhost/review": "workspace:*",
    "@selfhost/runtime": "workspace:*",
    "@selfhost/schema": "workspace:*",
    "@selfhost/spend": "workspace:*",
    "@selfhost/traces": "workspace:*",
    "hono": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@octokit/webhooks": "catalog:",
    "@selfhost/console": "workspace:*",
    "@selfhost/runtime": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
